                            fontSize: 21,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                        Text(
                          _formattedDate,
                          style: TextStyle(
                            color: Colors.white.withValues(alpha:0.72),
                            fontSize: 11,
                          ),
                        ),
                      ],
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 24),
              const Text(
                'Make today count.',
                style: TextStyle(
                  color: Colors.white,
                  fontSize: 25,
                  fontWeight: FontWeight.bold,
                  letterSpacing: -0.5,
                ),
              ),
              const SizedBox(height: 5),
              Text(
                'Small steps today, big changes tomorrow.',
                style: TextStyle(
                  color: Colors.white.withValues(alpha:0.75),
                  fontSize: 12,
                ),
              ),
              const SizedBox(height: 22),
              Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  const Text(
                    "Today's habit progress",
                    style: TextStyle(
                      color: Colors.white,
                      fontWeight: FontWeight.w600,
                      fontSize: 12,
                    ),
                  ),
                  Text(
                    '$completed / $total',
                    style: const TextStyle(
                      color: Colors.white,
                      fontWeight: FontWeight.bold,
                      fontSize: 13,
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 10),
              ClipRRect(
                borderRadius: BorderRadius.circular(20),
                child: LinearProgressIndicator(
                  value: progress.clamp(0.0, 1.0).toDouble(),
                  minHeight: 9,
                  backgroundColor: Colors.white.withValues(alpha:0.20),
                  valueColor: const AlwaysStoppedAnimation<Color>(
                    Color(0xFFFFD77A),
                  ),
                ),
              ),
              const SizedBox(height: 9),
              Text(
                total == 0
                    ? 'Start building your daily routine.'
                    : '${(progress * 100).round()}% of your habits completed today',
                style: TextStyle(
                  color: Colors.white.withValues(alpha:0.75),
                  fontSize: 11,
                ),
              ),
            ],
          ),
        ],
      ),
    );
  }

Widget _buildCategoryCard(Map<String, dynamic> category) {
  final name = category['name'] as String;
  final color = category['color'] as Color;
  final icon = category['icon'] as IconData;

  final isPrayer = name == 'Prayer';
  final completed = isPrayer ? 0 : _completedToday(name);
  final total = isPrayer ? 5 : _totalHabits(name);

  final progress = total == 0
      ? 0.0
      : (completed / total).clamp(0.0, 1.0).toDouble();

  final lightColor = Color.lerp(
    color,
    Colors.white,
    0.13,
  )!;

  final darkColor = Color.lerp(
    color,
    Colors.black,
    0.17,
  )!;

  return Material(
    color: Colors.transparent,
    child: InkWell(
      borderRadius: BorderRadius.circular(24),
      onTap: () => _openCategoryPage(name),
      child: Ink(
        decoration: BoxDecoration(
          gradient: LinearGradient(
            colors: [
              lightColor,
              color,
              darkColor,
            ],
            begin: Alignment.topLeft,
            end: Alignment.bottomRight,
          ),
          borderRadius: BorderRadius.circular(24),
          boxShadow: [
            BoxShadow(
              color: color.withValues(alpha: 0.20),
              blurRadius: 16,
              offset: const Offset(0, 7),
            ),
          ],
        ),
        child: ClipRRect(
          borderRadius: BorderRadius.circular(24),
          child: Stack(
            children: [
              Positioned(
                right: -32,
                top: -35,
                child: Container(
                  height: 115,
                  width: 115,
                  decoration: BoxDecoration(
                    shape: BoxShape.circle,
                    color: Colors.white.withValues(alpha: 0.10),
                  ),
                ),
              ),

              Positioned(
                right: 20,
                bottom: -65,
                child: Container(
                  height: 115,
                  width: 115,
                  decoration: BoxDecoration(
                    shape: BoxShape.circle,
                    color: Colors.white.withValues(alpha: 0.07),
                  ),
                ),
              ),

              Padding(
                padding: const EdgeInsets.all(16),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Container(
                      height: 46,
                      width: 46,
                      decoration: BoxDecoration(
                        color: Colors.white.withValues(alpha: 0.19),
                        borderRadius: BorderRadius.circular(16),
                        border: Border.all(
                          color: Colors.white.withValues(alpha: 0.22),
                        ),
                      ),
                      child: Icon(
                        icon,
                        color: Colors.white,
                        size: 25,
                      ),
                    ),

                    const SizedBox(height: 12),

                    Text(
                      name,
                      maxLines: 1,
                      overflow: TextOverflow.ellipsis,
                      style: const TextStyle(
                        color: Colors.white,
                        fontSize: 16,
                        fontWeight: FontWeight.w800,
                        letterSpacing: -0.3,
                      ),
                    ),

                    const SizedBox(height: 5),

                    Expanded(
                      child: Text(
                        category['subtitle']?.toString() ?? '',
                        maxLines: 2,
                        overflow: TextOverflow.ellipsis,
                        style: TextStyle(
                          color: Colors.white.withValues(alpha: 0.84),
                          fontSize: 10.5,
                          height: 1.4,
                        ),
                      ),
                    ),

                    const SizedBox(height: 9),

                    if (!isPrayer) ...[
                      ClipRRect(
                        borderRadius: BorderRadius.circular(10),
                        child: LinearProgressIndicator(
                          value: progress,
                          minHeight: 4,
                          backgroundColor:
                              Colors.white.withValues(alpha: 0.22),
                          valueColor:
                              const AlwaysStoppedAnimation<Color>(
                            Colors.white,
                          ),
                        ),
                      ),
                      const SizedBox(height: 9),
                    ],

                    Container(
                      padding: const EdgeInsets.symmetric(
                        horizontal: 9,
                        vertical: 7,
                      ),
                      decoration: BoxDecoration(
                        color: Colors.white.withValues(alpha: 0.17),
                        borderRadius: BorderRadius.circular(12),
                        border: Border.all(
                          color: Colors.white.withValues(alpha: 0.12),
                        ),
                      ),
                      child: Row(
                        mainAxisSize: MainAxisSize.min,
                        children: [
                          Icon(
                            isPrayer
                                ? Icons.favorite_rounded
                                : Icons.check_circle_rounded,
                            color: Colors.white,
                            size: 13,
                          ),
                          const SizedBox(width: 6),
                          Flexible(
                            child: Text(
                              isPrayer
                                  ? '5 Daily Prayers'
                                  : '$completed / $total completed',
                              maxLines: 1,
                              overflow: TextOverflow.ellipsis,
                              style: const TextStyle(
                                color: Colors.white,
                                fontSize: 9.5,
                                fontWeight: FontWeight.w700,
                              ),
                            ),
                          ),
                        ],
                      ),
                    ),
                  ],
                ),
              ),
            ],
          ),
        ),
      ),
    ),
  );
}

Widget _buildHabitsTab() {
  final habitCategories = categories
      .where((category) => category['name'] != 'Prayer')
      .toList();

  return Scaffold(
    appBar: AppBar(
      title: const Text(
        'My Habits',
        style: TextStyle(fontWeight: FontWeight.bold),
      ),
    ),
    body: ListView(
      padding: const EdgeInsets.all(18),
      children: [
        const Text(
          'Build Better Habits',
          style: TextStyle(
            fontSize: 21,
            fontWeight: FontWeight.bold,
            color: Color(0xFF29264A),
          ),
        ),
        const SizedBox(height: 5),
        Text(
          'Track your daily routines and stay consistent.',
          style: TextStyle(
            fontSize: 12,
            color: Colors.grey.shade600,
          ),
        ),
        const SizedBox(height: 20),
        GridView.builder(
          itemCount: habitCategories.length,
          shrinkWrap: true,
          physics: const NeverScrollableScrollPhysics(),
          gridDelegate:
              const SliverGridDelegateWithFixedCrossAxisCount(
            crossAxisCount: 2,
            crossAxisSpacing: 13,
            mainAxisSpacing: 13,
            mainAxisExtent: 195,
          ),
          itemBuilder: (context, index) {
            return _buildCategoryCard(habitCategories[index]);
          },
        ),
      ],
    ),
  );
}

