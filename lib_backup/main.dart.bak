// ==================================================
// CATEGORY HABITS SCREEN
// ==================================================

class CategoryHabitsScreen extends StatefulWidget {
  final String category;
  final List<Map<String, dynamic>> habits;
  final Map<String, IconData> habitIcons;

  final Future<void> Function() onAddHabit;
  final Future<void> Function(Map<String, dynamic>) onToggleHabit;
  final Future<void> Function(Map<String, dynamic>) onDeleteHabit;
  final Future<void> Function(Map<String, dynamic>) onSetReminder;
  final Future<void> Function(Map<String, dynamic>) onRemoveReminder;

  const CategoryHabitsScreen({
    super.key,
    required this.category,
    required this.habits,
    required this.habitIcons,
    required this.onAddHabit,
    required this.onToggleHabit,
    required this.onDeleteHabit,
    required this.onSetReminder,
    required this.onRemoveReminder,
  });

  @override
  State<CategoryHabitsScreen> createState() =>
      _CategoryHabitsScreenState();
}

class _CategoryHabitsScreenState extends State<CategoryHabitsScreen> {
  String get todayKey {
    final now = DateTime.now();
    return '${now.year}-${now.month.toString().padLeft(2, '0')}-${now.day.toString().padLeft(2, '0')}';
  }

  List<Map<String, dynamic>> get currentHabits {
    return widget.habits
        .where((habit) => habit['category'] == widget.category)
        .toList();
  }

  int get completedCount {
    return currentHabits.where((habit) {
      final dates = List<String>.from(
        habit['completedDates'] ?? [],
      );
      return dates.contains(todayKey);
    }).length;
  }

  double get progress {
    if (currentHabits.isEmpty) return 0;
    return completedCount / currentHabits.length;
  }

  Color get categoryColor {
    switch (widget.category) {
      case 'Study':
        return const Color(0xFF6558E8);
      case 'Spiritual':
        return const Color(0xFF159B83);
      case 'Health & Fitness':
        return const Color(0xFFE16B83);
      default:
        return const Color(0xFFDA9635);
    }
  }

  Future<void> _refreshAfter(
    Future<void> Function(Map<String, dynamic>) action,
    Map<String, dynamic> habit,
  ) async {
    await action(habit);
    if (mounted) setState(() {});
  }

  Future<void> _addHabit() async {
    await widget.onAddHabit();
    if (mounted) setState(() {});
  }

  @override
  Widget build(BuildContext context) {
    final items = currentHabits;

    return Scaffold(
      appBar: AppBar(
        title: Text(
          widget.category,
          style: const TextStyle(
            fontWeight: FontWeight.bold,
          ),
        ),
      ),
      floatingActionButton: FloatingActionButton(
        onPressed: _addHabit,
        backgroundColor: categoryColor,
        foregroundColor: Colors.white,
        child: const Icon(Icons.add),
      ),
      body: ListView(
        padding: const EdgeInsets.all(18),
        children: [
          // Daily progress
          Container(
            padding: const EdgeInsets.all(18),
            decoration: BoxDecoration(
              color: categoryColor,
              borderRadius: BorderRadius.circular(20),
            ),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                const Text(
                  'Daily Progress',
                  style: TextStyle(
                    color: Colors.white,
                    fontSize: 16,
                    fontWeight: FontWeight.w600,
                  ),
                ),
                const SizedBox(height: 12),
                Row(
                  crossAxisAlignment: CrossAxisAlignment.end,
                  children: [
                    Text(
                      '${(progress * 100).round()}%',
                      style: const TextStyle(
                        color: Colors.white,
                        fontSize: 34,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    const Spacer(),
                    Text(
                      '$completedCount of ${items.length} completed',
                      style: const TextStyle(
                        color: Colors.white,
                        fontSize: 12,
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: 12),
                ClipRRect(
                  borderRadius: BorderRadius.circular(20),
                  child: LinearProgressIndicator(
                    value: progress,
                    minHeight: 9,
                    backgroundColor: Colors.white.withValues(alpha:0.3),
                    valueColor:
                        const AlwaysStoppedAnimation<Color>(
                      Colors.white,
                    ),
                  ),
                ),
              ],
            ),
          ),

          const SizedBox(height: 22),

          Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              const Text(
                "Today's Habits",
                style: TextStyle(
                  fontSize: 19,
                  fontWeight: FontWeight.bold,
                ),
              ),
              Text(
                '$completedCount/${items.length}',
                style: const TextStyle(
                  color: Colors.grey,
                  fontWeight: FontWeight.w600,
                ),
              ),
            ],
          ),

          const SizedBox(height: 12),

          if (items.isEmpty)
            Container(
              width: double.infinity,
              padding: const EdgeInsets.all(25),
              decoration: BoxDecoration(
                color: Colors.white,
                borderRadius: BorderRadius.circular(18),
              ),
              child: Column(
                children: [
                  Icon(
                    Icons.checklist_rounded,
                    size: 45,
                    color: Colors.grey.shade400,
                  ),
                  const SizedBox(height: 10),
                  const Text(
                    'No habits yet',
                    style: TextStyle(
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                  const SizedBox(height: 5),
                  Text(
                    'Tap the + button to add your first habit.',
                    style: TextStyle(
                      color: Colors.grey.shade600,
                    ),
                    textAlign: TextAlign.center,
                  ),
                ],
              ),
            )
          else
            ...items.map(_buildHabitCard),
        ],
      ),
    );
  }

  Widget _buildHabitCard(Map<String, dynamic> habit) {
    final dates = List<String>.from(
      habit['completedDates'] ?? [],
    );

    final isDone = dates.contains(todayKey);
    final icon = widget.habitIcons[habit['icon']] ??
        Icons.star_rounded;

    final reminderEnabled = habit['reminderEnabled'] == true;
    final hour = habit['reminderHour'] ?? 8;
    final minute = habit['reminderMinute'] ?? 0;

    final reminderTime = TimeOfDay(
      hour: hour,
      minute: minute,
    ).format(context);

    return Container(
      margin: const EdgeInsets.only(bottom: 10),
      padding: const EdgeInsets.symmetric(
        horizontal: 14,
        vertical: 12,
      ),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(16),
        border: Border.all(
          color: Colors.grey.shade200,
        ),
      ),
      child: Row(
        children: [
          Container(
            height: 43,
            width: 43,
            decoration: BoxDecoration(
              color: categoryColor.withValues(alpha:0.09),
              borderRadius: BorderRadius.circular(13),
            ),
            child: Icon(
              icon,
              color: categoryColor,
            ),
          ),
          const SizedBox(width: 12),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  habit['name']?.toString() ?? 'Habit',
                  style: TextStyle(
                    fontWeight: FontWeight.w600,
                    decoration:
                        isDone ? TextDecoration.lineThrough : null,
                    color: isDone ? Colors.grey : Colors.black87,
                  ),
                ),
                const SizedBox(height: 4),
                GestureDetector(
                  onTap: () async {
                    if (reminderEnabled) {
                      await _refreshAfter(
                        widget.onRemoveReminder,
                        habit,
                      );
                    } else {
                      await _refreshAfter(
                        widget.onSetReminder,
                        habit,
                      );
                    }
                  },
                  child: Row(
                    children: [
                      Icon(
                        reminderEnabled
                            ? Icons.notifications_active_rounded
                            : Icons.notifications_none_rounded,
                        size: 14,
                        color: reminderEnabled
                            ? categoryColor
                            : Colors.grey,
                      ),
                      const SizedBox(width: 4),
                      Text(
                        reminderEnabled
                            ? 'Daily at $reminderTime'
                            : 'Set reminder',
                        style: TextStyle(
                          fontSize: 11,
                          color: reminderEnabled
                              ? categoryColor
                              : Colors.grey.shade600,
                        ),
                      ),
                    ],
                  ),
                ),
              ],
            ),
          ),
          IconButton(
            tooltip: 'Delete habit',
            onPressed: () async {
              await _refreshAfter(
                widget.onDeleteHabit,
                habit,
              );
            },
            icon: Icon(
              Icons.delete_outline_rounded,
              color: Colors.grey.shade400,
              size: 21,
            ),
          ),
          Checkbox(
            value: isDone,
            activeColor: categoryColor,
            shape: RoundedRectangleBorder(
              borderRadius: BorderRadius.circular(5),
            ),
            onChanged: (_) async {
              await _refreshAfter(
                widget.onToggleHabit,
                habit,
              );
            },
          ),
        ],
      ),
    );
  }
}

// ==================================================
// HISTORY SCREEN
// ==================================================

class HistoryScreen extends StatefulWidget {
  final List<Map<String, dynamic>> habits;
  final Map<String, IconData> habitIcons;

  const HistoryScreen({
    super.key,
    required this.habits,
    required this.habitIcons,
  });

  @override
  State<HistoryScreen> createState() => _HistoryScreenState();
}

class _HistoryScreenState extends State<HistoryScreen> {
  DateTime selectedMonth = DateTime.now();
  DateTime selectedDate = DateUtils.dateOnly(DateTime.now());

  String _dateKey(DateTime date) {
    return '${date.year}-${date.month.toString().padLeft(2, '0')}-${date.day.toString().padLeft(2, '0')}';
  }

  List<Map<String, dynamic>> get completedHabits {
    return widget.habits.where((habit) {
      final dates = List<String>.from(
        habit['completedDates'] ?? [],
      );
      return dates.contains(_dateKey(selectedDate));
    }).toList();
  }

  void _changeMonth(int amount) {
    setState(() {
      selectedMonth = DateTime(
        selectedMonth.year,
        selectedMonth.month + amount,
      );
    });
  }

  @override
  Widget build(BuildContext context) {
    final firstDay = DateTime(
      selectedMonth.year,
      selectedMonth.month,
      1,
    );

    final daysInMonth = DateTime(
      selectedMonth.year,
      selectedMonth.month + 1,
      0,
    ).day;

    final startingWeekday = firstDay.weekday % 7;

    return Scaffold(
      appBar: AppBar(
        title: const Text(
          'Calendar History',
          style: TextStyle(
            fontWeight: FontWeight.bold,
          ),
        ),
      ),
      body: ListView(
        padding: const EdgeInsets.all(18),
        children: [
          Container(
            padding: const EdgeInsets.all(18),
            decoration: BoxDecoration(
              color: Colors.white,
              borderRadius: BorderRadius.circular(20),
            ),
            child: Column(
              children: [
                Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    IconButton(
                      onPressed: () => _changeMonth(-1),
                      icon: const Icon(Icons.chevron_left),
                    ),
                    Text(
                      '${_monthName(selectedMonth.month)} ${selectedMonth.year}',
                      style: const TextStyle(
                        fontSize: 18,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    IconButton(
                      onPressed: () => _changeMonth(1),
                      icon: const Icon(Icons.chevron_right),
                    ),
                  ],
                ),
                const SizedBox(height: 12),
                Row(
                  children: [
                    'Sun',
                    'Mon',
                    'Tue',
                    'Wed',
                    'Thu',
                    'Fri',
                    'Sat',
                  ].map((day) {
                    return Expanded(
                      child: Center(
                        child: Text(
                          day,
                          style: const TextStyle(
                            color: Colors.grey,
                            fontSize: 12,
                            fontWeight: FontWeight.w600,
                          ),
                        ),
                      ),
                    );
                  }).toList(),
                ),
                const SizedBox(height: 10),
                GridView.builder(
                  shrinkWrap: true,
                  physics: const NeverScrollableScrollPhysics(),
                  itemCount: startingWeekday + daysInMonth,
                  gridDelegate:
                      const SliverGridDelegateWithFixedCrossAxisCount(
                    crossAxisCount: 7,
                    mainAxisSpacing: 8,
                    crossAxisSpacing: 5,
                  ),
                  itemBuilder: (context, index) {
                    if (index < startingWeekday) {
                      return const SizedBox();
                    }

                    final day = index - startingWeekday + 1;
                    final date = DateTime(
                      selectedMonth.year,
                      selectedMonth.month,
                      day,
                    );

                    final key = _dateKey(date);
                    final isSelected =
                        _dateKey(selectedDate) == key;

                    final completed = widget.habits.any((habit) {
                      final dates = List<String>.from(
                        habit['completedDates'] ?? [],
                      );
                      return dates.contains(key);
                    });

                    return GestureDetector(
                      onTap: () {
                        setState(() {
                          selectedDate = date;
                        });
                      },
                      child: Container(
                        decoration: BoxDecoration(
                          color: isSelected
                              ? const Color(0xFF6558E8)
                              : completed
                                  ? const Color(0xFF159B83)
                                      .withValues(alpha:0.12)
                                  : Colors.transparent,
                          shape: BoxShape.circle,
                        ),
                        child: Center(
                          child: Text(
                            '$day',
                            style: TextStyle(
                              fontWeight: isSelected
                                  ? FontWeight.bold
                                  : FontWeight.normal,
                              color: isSelected
                                  ? Colors.white
                                  : Colors.black87,
                            ),
                          ),
                        ),
                      ),
                    );
                  },
                ),
              ],
            ),
          ),
          const SizedBox(height: 22),
          Text(
            '${selectedDate.day} ${_monthName(selectedDate.month)} ${selectedDate.year}',
            style: const TextStyle(
              fontSize: 18,
              fontWeight: FontWeight.bold,
            ),
          ),
          const SizedBox(height: 12),
          if (completedHabits.isEmpty)
            const Padding(
              padding: EdgeInsets.all(25),
              child: Center(
                child: Text(
                  'No completed habits on this day.',
                ),
              ),
            )
          else
            ...completedHabits.map((habit) {
              final icon = widget.habitIcons[habit['icon']] ??
                  Icons.star_rounded;

              return Card(
                color: Colors.white,
                elevation: 0,
                child: ListTile(
                  leading: Icon(
                    icon,
                    color: const Color(0xFF159B83),
                  ),
                  title: Text(habit['name']),
                  subtitle: Text(habit['category']),
                  trailing: const Icon(
                    Icons.check_circle,
                    color: Color(0xFF159B83),
                  ),
                ),
              );
            }),
        ],
      ),
    );
  }

  String _monthName(int month) {
    const months = [
      'January',
      'February',
      'March',
      'April',
      'May',
      'June',
      'July',
      'August',
      'September',
      'October',
      'November',
      'December',
    ];

    return months[month - 1];
  }
}



// ==================================================
// ANALYTICS SCREEN
// ==================================================

enum AnalyticsPeriod { daily, weekly, monthly }

class AnalyticsScreen extends StatefulWidget {
  final List<Map<String, dynamic>> habits;

  const AnalyticsScreen({
    super.key,
    required this.habits,
  });

  @override
  State<AnalyticsScreen> createState() => _AnalyticsScreenState();
}




class _AnalyticsScreenState extends State<AnalyticsScreen> {
  static const String prayerStorageKey = 'prayer_tracker_v1';
  List<TaskModel> analyticsTasks = [];

  static const Color studyColor = Color(0xFF6558E8);
  static const Color spiritualColor = Color(0xFF159B83);
  static const Color prayerColor = Color(0xFFDA9635);
  static const Color healthColor = Color(0xFFE16B83);
  Map<String, int> get taskStats {
  int total = 0;
  int completed = 0;
  int pending = 0;
  int overdue = 0;
  int skipped = 0;

  for (
    var date = DateUtils.dateOnly(periodStart);
    !date.isAfter(DateUtils.dateOnly(periodEnd));
    date = date.add(const Duration(days: 1))
  ) {
    for (final task in analyticsTasks) {
      if (!task.isScheduledOn(date)) continue;

      total++;

      if (task.isCompletedOn(date)) {
        completed++;
      } else if (task.isSkippedOn(date)) {
        skipped++;
      } else if (date.isBefore(today)) {
        overdue++;
      } else {
        pending++;
      }
    }
  }

  return {
    'total': total,
    'completed': completed,
    'pending': pending,
    'overdue': overdue,
    'skipped': skipped,
  };
}

double get taskCompletionRate {
  final stats = taskStats;
  final total = stats['total'] ?? 0;

  if (total == 0) return 0;

  return (stats['completed'] ?? 0) / total;
}

  final List<String> prayerNames = [
    'Fajr',
    'Dhuhr',
    'Asr',
    'Maghrib',
    'Isha',
  ];

  Map<String, dynamic> prayerHistory = {};

List<Map<String, dynamic>> analyticsHabits = [];

bool isLoading = true;

  AnalyticsPeriod selectedPeriod = AnalyticsPeriod.daily;
  DateTime selectedDate = DateTime.now();

  DateTime get today {
    final now = DateTime.now();
    return DateTime(now.year, now.month, now.day);
  }

  String _dateKey(DateTime date) {
    return '${date.year}-'
        '${date.month.toString().padLeft(2, '0')}-'
        '${date.day.toString().padLeft(2, '0')}';
  }

  @override
  void initState() {
    super.initState();
    _loadPrayerHistory();
  }

  // --------------------------------------------------
  // LOAD PRAYER DATA
  // --------------------------------------------------

 Future<void> _loadPrayerHistory() async {
  final prefs = await SharedPreferences.getInstance();
  try {
  analyticsTasks = await TaskRepository.instance.getTasks();
} catch (e) {
  debugPrint('Task analytics error: $e');
  analyticsTasks = [];
}

  // Load latest habits
  final savedHabits = prefs.getString('habits');

  if (savedHabits != null) {
    try {
      final decodedHabits = jsonDecode(savedHabits);

      if (decodedHabits is List) {
        analyticsHabits = decodedHabits.map((item) {
          return Map<String, dynamic>.from(item);
        }).toList();
      }
    } catch (e) {
      debugPrint('Habit analytics error: $e');
      analyticsHabits = List<Map<String, dynamic>>.from(
        widget.habits,
      );
    }
  } else {
    analyticsHabits = List<Map<String, dynamic>>.from(
      widget.habits,
    );
  }

  // Load prayer history
  final savedPrayer = prefs.getString(prayerStorageKey);

  if (savedPrayer != null) {
    try {
      final decoded = jsonDecode(savedPrayer);

      if (decoded is Map) {
        prayerHistory = Map<String, dynamic>.from(decoded);
      }
    } catch (e) {
      debugPrint('Prayer analytics error: $e');
    }
  }

  if (!mounted) return;

  setState(() {
    isLoading = false;
  });
}

  // --------------------------------------------------
  // PERIOD DATE RANGE
  // --------------------------------------------------

DateTime get periodStart {
  final date = DateUtils.dateOnly(selectedDate);

  switch (selectedPeriod) {
    case AnalyticsPeriod.daily:
      return date;

    case AnalyticsPeriod.weekly:
      return date.subtract(
        Duration(days: date.weekday - 1),
      );

    case AnalyticsPeriod.monthly:
      return DateTime(date.year, date.month, 1);
  }
}

  DateTime get periodEnd {
    DateTime end;

    switch (selectedPeriod) {
      case AnalyticsPeriod.daily:
        end = selectedDate;
        break;

      case AnalyticsPeriod.weekly:
        end = periodStart.add(const Duration(days: 6));
        break;

      case AnalyticsPeriod.monthly:
        end = DateTime(
          selectedDate.year,
          selectedDate.month + 1,
          0,
        );
        break;
    }

    // Never count future days.
    return end.isAfter(today) ? today : end;
  }

  int get periodDays {
    if (periodEnd.isBefore(periodStart)) return 0;

    return periodEnd.difference(periodStart).inDays + 1;
  }

  String get periodLabel {
    switch (selectedPeriod) {
      case AnalyticsPeriod.daily:
        return '${selectedDate.day} ${_monthName(selectedDate.month)} ${selectedDate.year}';

      case AnalyticsPeriod.weekly:
        return '${periodStart.day} ${_monthName(periodStart.month)} - '
            '${periodEnd.day} ${_monthName(periodEnd.month)} ${periodEnd.year}';

      case AnalyticsPeriod.monthly:
        return '${_monthName(selectedDate.month)} ${selectedDate.year}';
    }
  }

  String _monthName(int month) {
    const months = [
      'January', 'February', 'March', 'April',
      'May', 'June', 'July', 'August',
      'September', 'October', 'November', 'December',
    ];

    return months[month - 1];
  }

  void _changePeriod(AnalyticsPeriod period) {
    setState(() {
      selectedPeriod = period;
    });
  }

  void _movePeriod(int amount) {
    DateTime next;

    switch (selectedPeriod) {
      case AnalyticsPeriod.daily:
        next = selectedDate.add(Duration(days: amount));
        break;

      case AnalyticsPeriod.weekly:
        next = selectedDate.add(Duration(days: amount * 7));
        break;

      case AnalyticsPeriod.monthly:
        next = DateTime(
          selectedDate.year,
          selectedDate.month + amount,
          1,
        );
        break;
    }

    if (next.isAfter(today)) return;

    setState(() {
      selectedDate = next;
    });
  }

  // --------------------------------------------------
  // HABIT STATISTICS
  // --------------------------------------------------

  int _habitCompletionCount(Map<String, dynamic> habit) {
    final dates = List<String>.from(
      habit['completedDates'] ?? [],
    );

    int count = 0;

    for (int i = 0; i < periodDays; i++) {
      final date = _dateKey(
        periodStart.add(Duration(days: i)),
      );

      if (dates.contains(date)) count++;
    }

    return count;
  }

 List<Map<String, dynamic>> _categoryHabits(String category) {
  return analyticsHabits.where((habit) {
    return habit['category'] == category;
  }).toList();
}

  int _categoryCompleted(String category) {
    return _categoryHabits(category).fold(
      0,
      (sum, habit) => sum + _habitCompletionCount(habit),
    );
  }

  int _categoryTarget(String category) {
    return _categoryHabits(category).length * periodDays;
  }

  double _percentage(int completed, int target) {
    if (target == 0) return 0;

    return (completed / target * 100).clamp(0, 100).toDouble();
  }

  // --------------------------------------------------
  // PRAYER STATISTICS
  // --------------------------------------------------

  Map<String, dynamic> _getPrayerData(
    String date,
    String prayer,
  ) {
    final dayData = prayerHistory[date];

    if (dayData is Map) {
      final data = dayData[prayer];

      if (data is Map) {
        return Map<String, dynamic>.from(data);
      }
    }

    return {};
  }

  bool _isPrayerCompleted(String date, String prayer) {
    return _getPrayerData(date, prayer)['prayed'] == true;
  }



  int _prayerCount(String prayer) {
    int count = 0;

    for (int i = 0; i < periodDays; i++) {
      final date = _dateKey(
        periodStart.add(Duration(days: i)),
      );

      if (_isPrayerCompleted(date, prayer)) count++;
    }

    return count;
  }

  int get totalPrayerCompleted {
    return prayerNames.fold(
      0,
      (sum, prayer) => sum + _prayerCount(prayer),
    );
  }

  int get prayerTarget => periodDays * 5;


  // --------------------------------------------------
  // OVERALL STATISTICS
  // --------------------------------------------------

 int get totalHabitCompleted {
  return analyticsHabits.fold(
    0,
    (sum, habit) => sum + _habitCompletionCount(habit),
  );
}

  int get totalOverallCompleted {
    return totalHabitCompleted + totalPrayerCompleted;
  }

  int get overallTarget {
  return (analyticsHabits.length * periodDays) + prayerTarget;
}

  double get overallPercentage {
    return _percentage(
      totalOverallCompleted,
      overallTarget,
    );
  }

  // --------------------------------------------------
  // UI HELPERS
  // --------------------------------------------------

  Widget _sectionTitle(
    String title, {
    String? subtitle,
  }) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(
          title,
          style: const TextStyle(
            fontSize: 19,
            fontWeight: FontWeight.bold,
          ),
        ),
        if (subtitle != null) ...[
          const SizedBox(height: 4),
          Text(
            subtitle,
            style: TextStyle(
              fontSize: 12,
              color: Colors.grey.shade600,
            ),
          ),
        ],
      ],
    );
  }

  Widget _periodSelector() {
    return Container(
      padding: const EdgeInsets.all(4),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(14),
      ),
      child: Row(
        children: [
          _periodButton('Daily', AnalyticsPeriod.daily),
          _periodButton('Weekly', AnalyticsPeriod.weekly),
          _periodButton('Monthly', AnalyticsPeriod.monthly),
        ],
      ),
    );
  }

  Widget _periodButton(
    String title,
    AnalyticsPeriod period,
  ) {
    final selected = selectedPeriod == period;

    return Expanded(
      child: GestureDetector(
        onTap: () => _changePeriod(period),
        child: Container(
          padding: const EdgeInsets.symmetric(vertical: 11),
          decoration: BoxDecoration(
            color: selected
                ? const Color(0xFF6558E8)
                : Colors.transparent,
            borderRadius: BorderRadius.circular(11),
          ),
          child: Text(
            title,
            textAlign: TextAlign.center,
            style: TextStyle(
              color: selected ? Colors.white : Colors.black54,
              fontWeight: FontWeight.w600,
            ),
          ),
        ),
      ),
    );
  }

  Widget _dateNavigation() {
    final isCurrentPeriod = selectedPeriod == AnalyticsPeriod.daily
        ? selectedDate == today
        : selectedPeriod == AnalyticsPeriod.weekly
            ? periodStart == today.subtract(
                Duration(days: today.weekday - 1),
              )
            : selectedDate.year == today.year &&
                selectedDate.month == today.month;

    return Row(
      children: [
        IconButton(
          onPressed: () => _movePeriod(-1),
          icon: const Icon(Icons.chevron_left_rounded),
        ),
        Expanded(
          child: Column(
            children: [
              Text(
                periodLabel,
                textAlign: TextAlign.center,
                style: const TextStyle(
                  fontWeight: FontWeight.bold,
                  fontSize: 14,
                ),
              ),
              Text(
                selectedPeriod == AnalyticsPeriod.daily
                    ? 'Selected day'
                    : selectedPeriod == AnalyticsPeriod.weekly
                        ? 'Monday - Sunday'
                        : 'Monthly report',
                style: TextStyle(
                  color: Colors.grey.shade600,
                  fontSize: 11,
                ),
              ),
            ],
          ),
        ),
        IconButton(
          onPressed: isCurrentPeriod
              ? null
              : () => _movePeriod(1),
          icon: const Icon(Icons.chevron_right_rounded),
        ),
      ],
    );
  }

  Widget _overallCard() {
    return Container(
      padding: const EdgeInsets.all(20),
      decoration: BoxDecoration(
        color: const Color(0xFF29264A),
        borderRadius: BorderRadius.circular(20),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const Text(
            'Overall Progress',
            style: TextStyle(
              color: Colors.white70,
              fontSize: 14,
            ),
          ),
          const SizedBox(height: 9),
          Row(
            children: [
              Text(
                '${overallPercentage.round()}%',
                style: const TextStyle(
                  color: Colors.white,
                  fontSize: 34,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const Spacer(),
              Text(
                '$totalOverallCompleted / $overallTarget',
                style: const TextStyle(
                  color: Colors.white70,
                  fontWeight: FontWeight.w600,
                ),
              ),
            ],
          ),
          const SizedBox(height: 13),
          ClipRRect(
            borderRadius: BorderRadius.circular(10),
            child: LinearProgressIndicator(
              value: overallTarget == 0
                  ? 0
                  : totalOverallCompleted / overallTarget,
              minHeight: 9,
              backgroundColor: Colors.white24,
              valueColor: const AlwaysStoppedAnimation<Color>(
                Colors.white,
              ),
            ),
          ),
          const SizedBox(height: 9),
          Text(
            '$periodDays ${periodDays == 1 ? 'day' : 'days'} included in this report',
            style: const TextStyle(
              color: Colors.white70,
              fontSize: 11,
            ),
          ),
        ],
      ),
    );
  }
Widget _taskMetric(
  String title,
  int value,
  Color color,
  IconData icon,
) {
  return Expanded(
    child: Container(
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: color.withValues(alpha: 0.08),
        borderRadius: BorderRadius.circular(12),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Icon(icon, color: color, size: 18),
              const SizedBox(width: 6),
              Expanded(
                child: Text(
                  title,
                  style: TextStyle(
                    fontSize: 12,
                    color: Colors.grey.shade600,
                  ),
                ),
              ),
            ],
          ),
          const SizedBox(height: 8),
          Text(
            value.toString(),
            style: TextStyle(
              fontSize: 23,
              fontWeight: FontWeight.bold,
              color: color,
            ),
          ),
        ],
      ),
    ),
  );
}

Widget _taskAnalyticsCard() {
  final stats = taskStats;
  final rate = taskCompletionRate;

  return Card(
    elevation: 0,
    shape: RoundedRectangleBorder(
      borderRadius: BorderRadius.circular(18),
      side: BorderSide(
        color: Colors.grey.withValues(alpha: 0.15),
      ),
    ),
    child: Padding(
      padding: const EdgeInsets.all(16),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Container(
                padding: const EdgeInsets.all(9),
                decoration: BoxDecoration(
                  color: studyColor.withValues(alpha: 0.12),
                  borderRadius: BorderRadius.circular(10),
                ),
                child: Icon(
                  Icons.task_alt_rounded,
                  color: studyColor,
                ),
              ),
              const SizedBox(width: 10),
              const Expanded(
                child: Text(
                  'Task Analytics',
                  style: TextStyle(
                    fontSize: 17,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ),
              Text(
                '${(rate * 100).toStringAsFixed(1)}%',
                style: TextStyle(
                  fontSize: 17,
                  fontWeight: FontWeight.bold,
                  color: studyColor,
                ),
              ),
            ],
          ),

          const SizedBox(height: 18),

          ClipRRect(
            borderRadius: BorderRadius.circular(10),
            child: LinearProgressIndicator(
              value: rate,
              minHeight: 9,
              backgroundColor: Colors.grey.withValues(alpha: 0.15),
              valueColor: AlwaysStoppedAnimation<Color>(studyColor),
            ),
          ),

          const SizedBox(height: 18),

          Row(
            children: [
              _taskMetric(
                'Total Tasks',
                stats['total'] ?? 0,
                Colors.blue,
                Icons.list_alt_rounded,
              ),
              const SizedBox(width: 10),
              _taskMetric(
                'Completed',
                stats['completed'] ?? 0,
                Colors.green,
                Icons.check_circle_outline_rounded,
              ),
            ],
          ),

          const SizedBox(height: 10),

          Row(
            children: [
              _taskMetric(
                'Pending',
                stats['pending'] ?? 0,
                Colors.orange,
                Icons.pending_actions_rounded,
              ),
              const SizedBox(width: 10),
              _taskMetric(
                'Overdue',
                stats['overdue'] ?? 0,
                Colors.red,
                Icons.warning_amber_rounded,
              ),
            ],
          ),

          const SizedBox(height: 12),

          Text(
            'Skipped: ${stats['skipped'] ?? 0}',
            style: TextStyle(
              fontSize: 12,
              color: Colors.grey.shade600,
            ),
          ),
        ],
      ),
    ),
  );
}
  Widget _categoryCard({
    required String title,
    required String subtitle,
    required IconData icon,
    required Color color,
    required int completed,
    required int target,
    required VoidCallback onTap,
  }) {
    final percentage = _percentage(completed, target);

    return Card(
      color: Colors.white,
      elevation: 0,
      margin: const EdgeInsets.only(bottom: 11),
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(17),
        side: BorderSide(color: Colors.grey.shade200),
      ),
      child: InkWell(
        borderRadius: BorderRadius.circular(17),
        onTap: onTap,
        child: Padding(
          padding: const EdgeInsets.all(15),
          child: Row(
            children: [
              Container(
                height: 45,
                width: 45,
                decoration: BoxDecoration(
                  color: color.withValues(alpha:0.12),
                  borderRadius: BorderRadius.circular(13),
                ),
                child: Icon(icon, color: color),
              ),
              const SizedBox(width: 13),
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      title,
                      style: const TextStyle(
                        fontWeight: FontWeight.bold,
                        fontSize: 14,
                      ),
                    ),
                    const SizedBox(height: 4),
                    Text(
                      '$completed of $target completed',
                      style: TextStyle(
                        color: Colors.grey.shade600,
                        fontSize: 11,
                      ),
                    ),
                    const SizedBox(height: 8),
                    ClipRRect(
                      borderRadius: BorderRadius.circular(10),
                      child: LinearProgressIndicator(
                        value: target == 0
                            ? 0
                            : completed / target,
                        minHeight: 6,
                        backgroundColor: color.withValues(alpha:0.12),
                        valueColor:
                            AlwaysStoppedAnimation<Color>(color),
                      ),
                    ),
                  ],
                ),
              ),
              const SizedBox(width: 10),
              Column(
                children: [
                  Text(
                    '${percentage.round()}%',
                    style: TextStyle(
                      color: color,
                      fontWeight: FontWeight.bold,
                      fontSize: 16,
                    ),
                  ),
                  const Icon(
                    Icons.chevron_right_rounded,
                    color: Colors.grey,
                  ),
                ],
              ),
            ],
          ),
        ),
      ),
    );
  }

  // --------------------------------------------------
  // CATEGORY DETAILS NAVIGATION
  // --------------------------------------------------

  void _openCategoryDetails(
    String category,
    Color color,
    IconData icon,
  ) {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (_) => HabitCategoryAnalyticsPage(
          category: category,
          color: color,
          icon: icon,
          habits: _categoryHabits(category),
          periodStart: periodStart,
          periodDays: periodDays,
          periodLabel: periodLabel,
        ),
      ),
    );
  }

  void _openPrayerDetails() {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (_) => PrayerAnalyticsPage(
          prayerHistory: prayerHistory,
          periodStart: periodStart,
          periodDays: periodDays,
          periodLabel: periodLabel,
        ),
      ),
    );
  }

  // --------------------------------------------------
  // MAIN ANALYTICS UI
  // --------------------------------------------------

  @override
  Widget build(BuildContext context) {
    if (isLoading) {
      return Scaffold(
        appBar: AppBar(title: const Text('Analytics')),
        body: const Center(
          child: CircularProgressIndicator(),
        ),
      );
    }

    return Scaffold(
      appBar: AppBar(
        title: const Text(
          'Analytics',
          style: TextStyle(fontWeight: FontWeight.bold),
        ),
      ),
      body: RefreshIndicator(
        onRefresh: _loadPrayerHistory,
        child: ListView(
          padding: const EdgeInsets.all(18),
          children: [
            _periodSelector(),
            const SizedBox(height: 10),
            _dateNavigation(),
            const SizedBox(height: 15),

           _overallCard(),

const SizedBox(height: 18),

_taskAnalyticsCard(),

const SizedBox(height: 27),

            _sectionTitle(
              'Category Performance',
              subtitle: 'Tap a category to see detailed statistics.',
            ),

            const SizedBox(height: 14),

            _categoryCard(
              title: 'Study',
              subtitle: 'Study habits',
              icon: Icons.school_rounded,
              color: studyColor,
              completed: _categoryCompleted('Study'),
              target: _categoryTarget('Study'),
              onTap: () => _openCategoryDetails(
                'Study',
                studyColor,
                Icons.school_rounded,
              ),
            ),

            _categoryCard(
              title: 'Spiritual',
              subtitle: 'Quran and Adhkar',
              icon: Icons.menu_book_rounded,
              color: spiritualColor,
              completed: _categoryCompleted('Spiritual'),
              target: _categoryTarget('Spiritual'),
              onTap: () => _openCategoryDetails(
                'Spiritual',
                spiritualColor,
                Icons.menu_book_rounded,
              ),
            ),

            _categoryCard(
              title: 'Prayer',
              subtitle: 'Five daily prayers',
              icon: Icons.mosque_rounded,
              color: prayerColor,
              completed: totalPrayerCompleted,
              target: prayerTarget,
              onTap: _openPrayerDetails,
            ),

            _categoryCard(
              title: 'Health & Fitness',
              subtitle: 'Healthy lifestyle habits',
              icon: Icons.fitness_center_rounded,
              color: healthColor,
              completed: _categoryCompleted('Health & Fitness'),
              target: _categoryTarget('Health & Fitness'),
              onTap: () => _openCategoryDetails(
                'Health & Fitness',
                healthColor,
                Icons.fitness_center_rounded,
              ),
            ),

            const SizedBox(height: 18),

            Center(
              child: Text(
                'Keep going. Small steps create big changes.',
                style: TextStyle(
                  color: Colors.grey.shade500,
                  fontSize: 12,
                ),
              ),
            ),

            const SizedBox(height: 20),
          ],
        ),
      ),
    );
  }
}

// ==================================================
// HABIT CATEGORY ANALYTICS PAGE
// ==================================================

class HabitCategoryAnalyticsPage extends StatelessWidget {
  final String category;
  final Color color;
  final IconData icon;
  final List<Map<String, dynamic>> habits;
  final DateTime periodStart;
  final int periodDays;
  final String periodLabel;

  const HabitCategoryAnalyticsPage({
    super.key,
    required this.category,
    required this.color,
    required this.icon,
    required this.habits,
    required this.periodStart,
    required this.periodDays,
    required this.periodLabel,
  });

  String _dateKey(DateTime date) {
    return '${date.year}-'
        '${date.month.toString().padLeft(2, '0')}-'
        '${date.day.toString().padLeft(2, '0')}';
  }

  int _completionCount(Map<String, dynamic> habit) {
    final dates = List<String>.from(
      habit['completedDates'] ?? [],
    );

    int count = 0;

    for (int i = 0; i < periodDays; i++) {
      final date = _dateKey(
        periodStart.add(Duration(days: i)),
      );

      if (dates.contains(date)) count++;
    }

    return count;
  }

  double _percentage(int completed, int target) {
    if (target == 0) return 0;
    return (completed / target * 100).clamp(0, 100).toDouble();
  }

  @override
  Widget build(BuildContext context) {
    final totalCompleted = habits.fold<int>(
      0,
      (sum, habit) => sum + _completionCount(habit),
    );

    final totalTarget = habits.length * periodDays;

    final percentage = _percentage(
      totalCompleted,
      totalTarget,
    );

    final ranked = habits.toList()
      ..sort(
        (a, b) => _completionCount(b).compareTo(
          _completionCount(a),
        ),
      );

    final bestHabit = ranked.isEmpty ? null : ranked.first;
    final weakestHabit = ranked.isEmpty ? null : ranked.last;

    return Scaffold(
      appBar: AppBar(
        title: Text('$category Statistics'),
      ),
      body: ListView(
        padding: const EdgeInsets.all(18),
        children: [
          Container(
            padding: const EdgeInsets.all(20),
            decoration: BoxDecoration(
              color: color,
              borderRadius: BorderRadius.circular(20),
            ),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Icon(icon, color: Colors.white, size: 30),
                const SizedBox(height: 14),
                Text(
                  '${percentage.round()}%',
                  style: const TextStyle(
                    color: Colors.white,
                    fontSize: 36,
                    fontWeight: FontWeight.bold,
                  ),
                ),
                const Text(
                  'Category Progress',
                  style: TextStyle(color: Colors.white70),
                ),
                const SizedBox(height: 12),
                Text(
                  '$totalCompleted / $totalTarget completions',
                  style: const TextStyle(
                    color: Colors.white,
                    fontWeight: FontWeight.w600,
                  ),
                ),
                const SizedBox(height: 10),
                ClipRRect(
                  borderRadius: BorderRadius.circular(10),
                  child: LinearProgressIndicator(
                    value: totalTarget == 0
                        ? 0
                        : totalCompleted / totalTarget,
                    minHeight: 8,
                    backgroundColor: Colors.white30,
                    valueColor:
                        const AlwaysStoppedAnimation<Color>(
                      Colors.white,
                    ),
                  ),
                ),
              ],
            ),
          ),

          const SizedBox(height: 17),

          Text(
            periodLabel,
            style: TextStyle(
              color: Colors.grey.shade600,
              fontSize: 13,
              fontWeight: FontWeight.w600,
            ),
          ),

          const SizedBox(height: 22),

          const Text(
            'Habit-wise Performance',
            style: TextStyle(
              fontSize: 19,
              fontWeight: FontWeight.bold,
            ),
          ),

          const SizedBox(height: 13),

          if (habits.isEmpty)
            const Center(
              child: Padding(
                padding: EdgeInsets.all(25),
                child: Text('No habits in this category.'),
              ),
            )
          else
            ...habits.map((habit) {
              final completed = _completionCount(habit);
              final target = periodDays;
              final progress = _percentage(completed, target);

              return Container(
                margin: const EdgeInsets.only(bottom: 12),
                padding: const EdgeInsets.all(15),
                decoration: BoxDecoration(
                  color: Colors.white,
                  borderRadius: BorderRadius.circular(16),
                  border: Border.all(color: Colors.grey.shade200),
                ),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Row(
                      children: [
                        Expanded(
                          child: Text(
                            habit['name']?.toString() ?? 'Habit',
                            style: const TextStyle(
                              fontWeight: FontWeight.w600,
                            ),
                          ),
                        ),
                        Text(
                          '${progress.round()}%',
                          style: TextStyle(
                            color: color,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                      ],
                    ),
                    const SizedBox(height: 10),
                    ClipRRect(
                      borderRadius: BorderRadius.circular(10),
                      child: LinearProgressIndicator(
                        value: target == 0
                            ? 0
                            : completed / target,
                        minHeight: 7,
                        backgroundColor: color.withValues(alpha:0.12),
                        valueColor:
                            AlwaysStoppedAnimation<Color>(color),
                      ),
                    ),
                    const SizedBox(height: 7),
                    Text(
                      '$completed of $target days completed',
                      style: TextStyle(
                        color: Colors.grey.shade600,
                        fontSize: 11,
                      ),
                    ),
                  ],
                ),
              );
            }),

          const SizedBox(height: 18),

          const Text(
            'Performance Insights',
            style: TextStyle(
              fontSize: 19,
              fontWeight: FontWeight.bold,
            ),
          ),

          const SizedBox(height: 12),

          _insightCard(
            icon: Icons.emoji_events_rounded,
            color: const Color(0xFFDA9635),
            title: 'Best Performing Habit',
            value: bestHabit?['name']?.toString() ?? 'No data',
            subtitle: bestHabit == null
                ? 'No habits available'
                : '${_completionCount(bestHabit)} completions',
          ),

          const SizedBox(height: 10),

          _insightCard(
            icon: Icons.trending_down_rounded,
            color: const Color(0xFFE16B83),
            title: 'Needs Improvement',
            value: weakestHabit?['name']?.toString() ?? 'No data',
            subtitle: weakestHabit == null
                ? 'No habits available'
                : '${_completionCount(weakestHabit)} completions',
          ),
        ],
      ),
    );
  }

  Widget _insightCard({
    required IconData icon,
    required Color color,
    required String title,
    required String value,
    required String subtitle,
  }) {
    return Container(
      padding: const EdgeInsets.all(15),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(15),
        border: Border.all(color: Colors.grey.shade200),
      ),
      child: Row(
        children: [
          CircleAvatar(
            backgroundColor: color.withValues(alpha:0.12),
            child: Icon(icon, color: color),
          ),
          const SizedBox(width: 12),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  title,
                  style: TextStyle(
                    color: Colors.grey.shade600,
                    fontSize: 11,
                  ),
                ),
                const SizedBox(height: 4),
                Text(
                  value,
                  style: const TextStyle(
                    fontWeight: FontWeight.bold,
                  ),
                ),
                Text(
                  subtitle,
                  style: TextStyle(
                    color: Colors.grey.shade500,
                    fontSize: 11,
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }
}

// ==================================================
// PRAYER ANALYTICS PAGE
// ==================================================

class PrayerAnalyticsPage extends StatelessWidget {
  final Map<String, dynamic> prayerHistory;
  final DateTime periodStart;
  final int periodDays;
  final String periodLabel;

  const PrayerAnalyticsPage({
    super.key,
    required this.prayerHistory,
    required this.periodStart,
    required this.periodDays,
    required this.periodLabel,
  });

  static const Color prayerColor = Color(0xFFDA9635);

  final List<String> prayerNames = const [
    'Fajr',
    'Dhuhr',
    'Asr',
    'Maghrib',
    'Isha',
  ];

  String _dateKey(DateTime date) {
    return '${date.year}-'
        '${date.month.toString().padLeft(2, '0')}-'
        '${date.day.toString().padLeft(2, '0')}';
  }

  Map<String, dynamic> _getPrayerData(
    String date,
    String prayer,
  ) {
    final dayData = prayerHistory[date];

    if (dayData is Map) {
      final data = dayData[prayer];

      if (data is Map) {
        return Map<String, dynamic>.from(data);
      }
    }

    return {};
  }

  int _prayerCount(String prayer) {
    int count = 0;

    for (int i = 0; i < periodDays; i++) {
      final date = _dateKey(
        periodStart.add(Duration(days: i)),
      );

      if (_getPrayerData(date, prayer)['prayed'] == true) {
        count++;
      }
    }

    return count;
  }

  int _extraCount(String extra) {
    int count = 0;

    for (int i = 0; i < periodDays; i++) {
      final date = _dateKey(
        periodStart.add(Duration(days: i)),
      );

      for (final prayer in prayerNames) {
        if (_getPrayerData(date, prayer)[extra] == true) {
          count++;
        }
      }
    }

    return count;
  }

  @override
  Widget build(BuildContext context) {
    final totalCompleted = prayerNames.fold<int>(
      0,
      (sum, prayer) => sum + _prayerCount(prayer),
    );

    final target = periodDays * 5;

    final percentage = target == 0
        ? 0
        : (totalCompleted / target * 100).round();

    return Scaffold(
      appBar: AppBar(
        title: const Text('Prayer Statistics'),
      ),
      body: ListView(
        padding: const EdgeInsets.all(18),
        children: [
          Container(
            padding: const EdgeInsets.all(20),
            decoration: BoxDecoration(
              color: prayerColor,
              borderRadius: BorderRadius.circular(20),
            ),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                const Icon(
                  Icons.mosque_rounded,
                  color: Colors.white,
                  size: 30,
                ),
                const SizedBox(height: 12),
                Text(
                  '$percentage%',
                  style: const TextStyle(
                    color: Colors.white,
                    fontSize: 36,
                    fontWeight: FontWeight.bold,
                  ),
                ),
                const Text(
                  'Prayer Completion',
                  style: TextStyle(color: Colors.white70),
                ),
                const SizedBox(height: 12),
                Text(
                  '$totalCompleted / $target prayers completed',
                  style: const TextStyle(
                    color: Colors.white,
                    fontWeight: FontWeight.w600,
                  ),
                ),
                const SizedBox(height: 10),
                ClipRRect(
                  borderRadius: BorderRadius.circular(10),
                  child: LinearProgressIndicator(
                    value: target == 0
                        ? 0
                        : totalCompleted / target,
                    minHeight: 8,
                    backgroundColor: Colors.white30,
                    valueColor:
                        const AlwaysStoppedAnimation<Color>(
                      Colors.white,
                    ),
                  ),
                ),
              ],
            ),
          ),

          const SizedBox(height: 15),

          Text(
            periodLabel,
            style: TextStyle(
              color: Colors.grey.shade600,
              fontSize: 13,
              fontWeight: FontWeight.w600,
            ),
          ),

          const SizedBox(height: 23),

          const Text(
            'Prayer-wise Statistics',
            style: TextStyle(
              fontSize: 19,
              fontWeight: FontWeight.bold,
            ),
          ),

          const SizedBox(height: 12),

          ...prayerNames.map((prayer) {
            final count = _prayerCount(prayer);
            final progress = periodDays == 0
                ? 0.0
                : count / periodDays;

            return Container(
              margin: const EdgeInsets.only(bottom: 11),
              padding: const EdgeInsets.all(15),
              decoration: BoxDecoration(
                color: Colors.white,
                borderRadius: BorderRadius.circular(15),
                border: Border.all(color: Colors.grey.shade200),
              ),
              child: Column(
                children: [
                  Row(
                    children: [
                      Expanded(
                        child: Text(
                          prayer,
                          style: const TextStyle(
                            fontWeight: FontWeight.w600,
                          ),
                        ),
                      ),
                      Text(
                        '$count / $periodDays',
                        style: const TextStyle(
                          color: prayerColor,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    ],
                  ),
                  const SizedBox(height: 10),
                  ClipRRect(
                    borderRadius: BorderRadius.circular(10),
                    child: LinearProgressIndicator(
                      value: progress,
                      minHeight: 7,
                      backgroundColor: prayerColor.withValues(alpha:0.12),
                      valueColor:
                          const AlwaysStoppedAnimation<Color>(
                        prayerColor,
                      ),
                    ),
                  ),
                ],
              ),
            );
          }),

          const SizedBox(height: 20),

          const Text(
            'Additional Worship',
            style: TextStyle(
              fontSize: 19,
              fontWeight: FontWeight.bold,
            ),
          ),

          const SizedBox(height: 5),

          Text(
            'These activities are tracked separately from prayer completion.',
            style: TextStyle(
              color: Colors.grey.shade600,
              fontSize: 12,
            ),
          ),

          const SizedBox(height: 13),

          _extraCard(
            title: 'Masjid',
            subtitle: 'Prayed in congregation',
            count: _extraCount('masjid'),
            icon: Icons.mosque_rounded,
          ),

          const SizedBox(height: 10),

          _extraCard(
            title: 'Adhkar',
            subtitle: 'Post-prayer remembrance',
            count: _extraCount('adhkar'),
            icon: Icons.auto_awesome_rounded,
          ),

          const SizedBox(height: 10),

          _extraCard(
            title: 'Ayatul Kursi',
            subtitle: 'Recitation after Salah',
            count: _extraCount('ayat'),
            icon: Icons.menu_book_rounded,
          ),
        ],
      ),
    );
  }

  Widget _extraCard({
    required String title,
    required String subtitle,
    required int count,
    required IconData icon,
  }) {
    final target = periodDays * 5;
    final percentage = target == 0
        ? 0
        : (count / target * 100).round();

    return Container(
      padding: const EdgeInsets.all(15),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(15),
        border: Border.all(color: Colors.grey.shade200),
      ),
      child: Row(
        children: [
          CircleAvatar(
            backgroundColor: const Color(0xFF159B83).withValues(alpha:0.12),
            child: Icon(
              icon,
              color: const Color(0xFF159B83),
            ),
          ),
          const SizedBox(width: 12),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  title,
                  style: const TextStyle(
                    fontWeight: FontWeight.w600,
                  ),
                ),
                const SizedBox(height: 3),
                Text(
                  subtitle,
                  style: TextStyle(
                    color: Colors.grey.shade600,
                    fontSize: 11,
                  ),
                ),
                const SizedBox(height: 8),
                ClipRRect(
                  borderRadius: BorderRadius.circular(10),
                  child: LinearProgressIndicator(
                    value: target == 0
                        ? 0
                        : count / target,
                    minHeight: 6,
                    backgroundColor:
                        const Color(0xFF159B83).withValues(alpha:0.12),
                    valueColor:
                        const AlwaysStoppedAnimation<Color>(
                      Color(0xFF159B83),
                    ),
                  ),
                ),
              ],
            ),
          ),
          const SizedBox(width: 10),
          Column(
            crossAxisAlignment: CrossAxisAlignment.end,
            children: [
              Text(
                '$count',
                style: const TextStyle(
                  fontWeight: FontWeight.bold,
                  fontSize: 17,
                ),
              ),
              Text(
                '$percentage%',
                style: TextStyle(
                  color: Colors.grey.shade600,
                  fontSize: 11,
                ),
              ),
            ],
          ),
        ],
      ),
    );
  }
}
// ==================================================
// ADD HABIT DIALOG
// ==================================================

class AddHabitDialog extends StatefulWidget {
  final Map<String, IconData> habitIcons;

  const AddHabitDialog({
    super.key,
    required this.habitIcons,
  });

  @override
  State<AddHabitDialog> createState() => _AddHabitDialogState();
}

class _AddHabitDialogState extends State<AddHabitDialog> {
  late final TextEditingController nameController;

  String selectedIcon = 'star';

  @override
  void initState() {
    super.initState();
    nameController = TextEditingController();
  }

  @override
  void dispose() {
    nameController.dispose();
    super.dispose();
  }

  void _addHabit() {
    final name = nameController.text.trim();

    if (name.isEmpty) {
      return;
    }

    Navigator.of(context).pop({
      'name': name,
      'icon': selectedIcon,
    });
  }

  @override
  Widget build(BuildContext context) {
    return AlertDialog(
      title: const Text(
        'Add New Habit',
        style: TextStyle(
          fontWeight: FontWeight.bold,
        ),
      ),
      content: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          TextField(
            controller: nameController,
            autofocus: true,
            textCapitalization: TextCapitalization.sentences,
            decoration: const InputDecoration(
              labelText: 'Habit name',
              hintText: 'Enter habit name',
              border: OutlineInputBorder(),
            ),
            onSubmitted: (_) => _addHabit(),
          ),

          const SizedBox(height: 18),

          DropdownButtonFormField<String>(
            initialValue: selectedIcon,
            isExpanded: true,
            decoration: const InputDecoration(
              labelText: 'Select icon',
              border: OutlineInputBorder(),
            ),
            items: widget.habitIcons.entries.map((entry) {
              return DropdownMenuItem<String>(
                value: entry.key,
                child: Row(
                  children: [
                    Icon(entry.value),
                    const SizedBox(width: 10),
                    Text(entry.key),
                  ],
                ),
              );
            }).toList(),
            onChanged: (value) {
              if (value == null) return;

              setState(() {
                selectedIcon = value;
              });
            },
          ),
        ],
      ),
      actions: [
        TextButton(
          onPressed: () {
            Navigator.of(context).pop();
          },
          child: const Text('Cancel'),
        ),

        FilledButton.icon(
          onPressed: _addHabit,
          icon: const Icon(Icons.add),
          label: const Text('Add'),
        ),
      ],
    );
  }
}
