class HabitFlowApp extends StatelessWidget {
  const HabitFlowApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'HabitFlow',
      debugShowCheckedModeBanner: false,
     
theme: ThemeData(
  useMaterial3: true,

  colorScheme: ColorScheme.fromSeed(
    seedColor: const Color(0xFF6558E8),
    brightness: Brightness.light,
  ),

  scaffoldBackgroundColor: const Color(0xFFF3F0FF),

  appBarTheme: const AppBarTheme(
    backgroundColor: Color(0xFFF3F0FF),
    surfaceTintColor: Colors.transparent,
    elevation: 0,
    foregroundColor: Color(0xFF29264A),
  ),
),

      home: const AppStartupScreen(),
    );
  }
}

class AppStartupScreen extends StatefulWidget {
  const AppStartupScreen({super.key});

  @override
  State<AppStartupScreen> createState() => _AppStartupScreenState();
}

class _AppStartupScreenState extends State<AppStartupScreen> {
  bool isInitialized = false;
  String? initializationError;

  @override
  void initState() {
    super.initState();
    _initializeApp();
  }

 
Future<void> _initializeApp() async {
  try {
    debugPrint('STARTUP 1: Firebase starting');

    await Firebase.initializeApp(
      options: DefaultFirebaseOptions.currentPlatform,
    );

    debugPrint('STARTUP 2: Firebase completed');

    await NotificationService.instance.initialize();

    debugPrint('STARTUP 3: Notification completed');

    if (!mounted) return;

    setState(() {
      isInitialized = true;
    });

    debugPrint('STARTUP 4: Startup completed');

  } catch (e) {
    debugPrint('STARTUP ERROR: $e');

    if (!mounted) return;

    setState(() {
      initializationError = e.toString();
    });
  }
}


  @override
  Widget build(BuildContext context) {
    if (isInitialized) {
      return const AuthGate();
    }

    return Scaffold(
      backgroundColor: const Color(0xFF17152D),
      body: Container(
        width: double.infinity,
        decoration: const BoxDecoration(
          gradient: LinearGradient(
            begin: Alignment.topLeft,
            end: Alignment.bottomRight,
            colors: [
              Color(0xFF17152D),
              Color(0xFF28204F),
              Color(0xFF17152D),
            ],
          ),
        ),
        child: SafeArea(
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              const Spacer(),

              Image.asset(
                'assets/images/habitflow_logo.png',
                width: 145,
                height: 145,
                fit: BoxFit.contain,
              ),

              const SizedBox(height: 12),

              const Text(
                'HabitFlow',
                style: TextStyle(
                  fontSize: 34,
                  fontWeight: FontWeight.bold,
                  color: Colors.white,
                  letterSpacing: 0.5,
                ),
              ),

              const SizedBox(height: 10),

              const Text(
                'Build Better Habits. Build Better Life.',
                style: TextStyle(
                  fontSize: 14,
                  color: Color(0xFFC5BFF0),
                ),
                textAlign: TextAlign.center,
              ),

              const Spacer(),

              if (initializationError != null) ...[
                const Icon(
                  Icons.error_outline_rounded,
                  color: Colors.redAccent,
                  size: 28,
                ),
                const SizedBox(height: 8),
                const Text(
                  'Unable to initialize HabitFlow',
                  style: TextStyle(color: Colors.white),
                ),
                TextButton(
                  onPressed: () {
                    setState(() {
                      initializationError = null;
                    });
                    _initializeApp();
                  },
                  child: const Text(
                    'Try Again',
                    style: TextStyle(color: Color(0xFFB78AFF)),
                  ),
                ),
              ] else ...[
                const SizedBox(
                  width: 26,
                  height: 26,
                  child: CircularProgressIndicator(
                    strokeWidth: 2.5,
                    valueColor: AlwaysStoppedAnimation<Color>(
                      Color(0xFFB78AFF),
                    ),
                  ),
                ),
                const SizedBox(height: 14),
                const Text(
                  'YOUR PERSONAL LIFE COMPANION',
                  style: TextStyle(
                    fontSize: 10,
                    letterSpacing: 2,
                    color: Color(0xFFA9A3CA),
                  ),
                ),
              ],

              const SizedBox(height: 55),
            ],
          ),
        ),
      ),
    );
  }
}

// ==================================================
// AUTH GATE
// ==================================================

class AuthGate extends StatelessWidget {
  const AuthGate({super.key});

  @override
  Widget build(BuildContext context) {
    return StreamBuilder<User?>(
      stream: FirebaseAuth.instance.authStateChanges(),
      builder: (context, snapshot) {
        debugPrint(
  'AUTH STATE: ${snapshot.connectionState}, '
  'Has Data: ${snapshot.hasData}',
);

        // Firebase Auth is checking login status.
        if (snapshot.connectionState == ConnectionState.waiting) {
          return Scaffold(
            backgroundColor: const Color(0xFF17152D),
            body: Container(
              width: double.infinity,
              decoration: const BoxDecoration(
                gradient: LinearGradient(
                  begin: Alignment.topLeft,
                  end: Alignment.bottomRight,
                  colors: [
                    Color(0xFF17152D),
                    Color(0xFF28204F),
                    Color(0xFF17152D),
                  ],
                ),
              ),
              child: SafeArea(
                child: Column(
                  mainAxisAlignment: MainAxisAlignment.center,
                  children: [
                    Image.asset(
                      'assets/images/habitflow_logo.png',
                      width: 120,
                      height: 120,
                      fit: BoxFit.contain,
                    ),

                    const SizedBox(height: 16),

                    const Text(
                      'HabitFlow',
                      style: TextStyle(
                        fontSize: 32,
                        fontWeight: FontWeight.bold,
                        color: Colors.white,
                      ),
                    ),

                    const SizedBox(height: 10),

                    const Text(
                      'Build Better Habits. Build Better Life.',
                      style: TextStyle(
                        fontSize: 13,
                        color: Color(0xFFC5BFF0),
                      ),
                    ),

                    const SizedBox(height: 35),

                    const SizedBox(
                      width: 26,
                      height: 26,
                      child: CircularProgressIndicator(
                        strokeWidth: 2.5,
                        valueColor: AlwaysStoppedAnimation<Color>(
                          Color(0xFFB78AFF),
                        ),
                      ),
                    ),

                    const SizedBox(height: 16),

                    const Text(
                      'Preparing your experience...',
                      style: TextStyle(
                        fontSize: 12,
                        color: Color(0xFFA9A3CA),
                        letterSpacing: 0.5,
                      ),
                    ),
                  ],
                ),
              ),
            ),
          );
        }

        // User is logged in.
        if (snapshot.hasData) {
          return const HomeScreen();
        }

        // User is not logged in.
        return const LoginScreen();
      },
    );
  }
}


